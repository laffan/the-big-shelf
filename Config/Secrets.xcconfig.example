// Copy this file to `Config/Secrets.xcconfig` and fill in your Dropbox app key.
//
// 1. Go to https://www.dropbox.com/developers/apps and create an app:
//      - API: "Scoped access"
//      - Access type: "Full Dropbox" (so it can see your Calibre folder anywhere)
// 2. On the app's "Permissions" tab, enable these scopes:
//      account_info.read, files.metadata.read, files.content.read
// 3. Copy the "App key" from the Settings tab into the line below.
//
// The app uses the PKCE OAuth flow, so NO app secret is needed (and you should
// never embed one in a mobile app).

DROPBOX_APP_KEY = paste_your_app_key_here
